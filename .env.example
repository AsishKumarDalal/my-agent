# Copy to .env and fill in. Any OpenAI-compatible provider works.
BASE_URL=https://openrouter.ai/api/v1
API_KEY=your-key-here
MODEL=openai/gpt-4o-mini

# Streaming: render model text token-by-token as it arrives. Set to 0 to
# restore silent-until-done behavior (useful for logs / non-interactive runs).
AGENT_STREAM=1
